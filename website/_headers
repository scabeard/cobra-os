# Cloudflare Pages headers — hardened, like the OS.
# https://developers.cloudflare.com/pages/configuration/headers/

# Tor mirror: the home-server hidden service is live (see README.md →
# "The Tor mirror (.onion)"). Tor Browser auto-offers the onion to clearnet
# visitors via this header:
#
/*
  Onion-Location: http://afrt77bagg4l4r6k56kshbbxjb6oot6dg7gwt3g5jopk4pe7ddjv3zad.onion$request_uri

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests

/assets/*
  Cache-Control: public, max-age=86400, immutable

# the operator shell mirror — served as plain text so browsers display it and
# `source <(curl ...)` gets exactly the bytes from shell/ (short cache: the
# mirror tracks the repo, updates must propagate fast)
/shell/*
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=300

# the CobraStrike installer — plain text so `curl ... | bash` gets clean bytes
/cobra/install.sh
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=300

# the CobraStrike agent bundle — real JS so it can also be inspected in-browser
/cobra/*/cobra.js
  Content-Type: application/javascript; charset=utf-8
  Cache-Control: public, max-age=300

/downloads/*
  Cache-Control: public, max-age=3600
  Content-Disposition: attachment
